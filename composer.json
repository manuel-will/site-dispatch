{
	"name": "manuelwill/site-dispatch",
	"description": "WordPress plugin that sends a signed, read-only status report to a server you connect it to.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"phpstan/phpstan": "^2.1",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"stan": "phpstan analyse",
		"cs": "phpcs",
		"vectors": "php tests/vectors/verify-vectors.php"
	}
}
