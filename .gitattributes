# Line endings: LF everywhere, so the same commit gives the same bytes on every machine.
* text=auto eol=lf

# Test vectors are signed or hashed byte for byte. Never touch them.
tests/vectors/** -text

# Not part of a release archive.
/.gitattributes    export-ignore
/.gitignore        export-ignore
/.gitleaks.toml    export-ignore
/.githooks         export-ignore
/composer.json     export-ignore
/composer.lock     export-ignore
/phpunit.xml.dist  export-ignore
/phpstan.neon.dist export-ignore
/phpcs.xml.dist    export-ignore
/docs              export-ignore
/tests             export-ignore
/tools             export-ignore
/PROTOCOL.md       export-ignore
/SECURITY.md       export-ignore
